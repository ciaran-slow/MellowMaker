# Dependencies
# No trailing slash on purpose: a worktree's `node_modules` is a *symlink* to
# the shared install, and `node_modules/` matches a directory only — so every
# stage running in a worktree saw `?? node_modules` in `git status` and had to
# re-establish it was setup residue rather than uncommitted work (issue #42).
node_modules

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# Debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# Local environment files
.env*.local

# Local Claude state
.claude/settings.local.json
.claude/worktrees/

# TypeScript
*.tsbuildinfo

# Generated native projects
/ios
/android
