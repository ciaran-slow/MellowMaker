{
  "name": "mellow-maker",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint . && npm run lint:architecture",
    "lint:architecture": "node scripts/check-architecture-boundaries.js",
    "generate:types": "expo customize tsconfig.json",
    "typecheck": "npm run generate:types && tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:smoke:foundation": "maestro test -e APP_ID=$APP_ID .maestro/foundation.yaml",
    "test:smoke:database": "maestro test -e APP_ID=$APP_ID .maestro/database.yaml",
    "test:smoke:dictionary": "maestro test -e APP_ID=$APP_ID .maestro/dictionary.yaml",
    "test:smoke:patterns": "maestro test -e APP_ID=$APP_ID .maestro/patterns.yaml"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "expo": "~57.0.11",
    "expo-asset": "~57.0.9",
    "expo-constants": "~57.0.9",
    "expo-crypto": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.11",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.13.3",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.3",
    "tailwindcss": "^3.4.19",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=25"
  }
}
